# local dev logs and throwaway test screenshots, all at the repo root.
# Scoped with a leading slash so docs/ keeps its wireframes.
/.dev-*.log
/gradle-build.log
/sdk-*.log
/ndk-install.log
/x86-image.log
/*.png
models-archive/

# Scratch from device debugging. These were committed by accident via
# `git add -A` and are pure noise: adb screenshots and uiautomator dumps.
# Screenshots of a running app belong in docs/, named, or nowhere.
/*.png
/*.xml
/*.log
